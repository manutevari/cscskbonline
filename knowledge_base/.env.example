# Supabase server-side credentials only. Never expose these to browsers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI-compatible embedding endpoint and model. text-embedding-3-small = 1536 dimensions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Required shared secret for service-to-service API calls.
# Optional: live web search for current recruitments. If unset, search is disabled.
TAVILY_API_KEY=

KB_API_TOKEN=
KB_ALLOWED_ORIGINS=https://cscskb.online,https://www.cscskb.online
MAX_UPLOAD_BYTES=15000000
