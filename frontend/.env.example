# Appointment database (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (server only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_CUSTOMER_TEMPLATE=csc_appointment_confirmation
WHATSAPP_OWNER_TEMPLATE=csc_new_appointment_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
CSC_OWNER_WHATSAPP=918937887070

# CSCSKB AI Marketing Agent — use separate, long random secrets per authorized human role.
# Never expose these as NEXT_PUBLIC_* variables or commit real values.
CSCSKB_MARKETING_OWNER_TOKEN=
CSCSKB_MARKETING_OWNER_ID=owner
CSCSKB_MARKETING_MANAGER_TOKEN=
CSCSKB_MARKETING_MANAGER_ID=marketing-manager
CSCSKB_MARKETING_EXPERT_TOKEN=
CSCSKB_MARKETING_EXPERT_ID=service-expert
CSCSKB_MARKETING_OPERATIONS_TOKEN=
CSCSKB_MARKETING_OPERATIONS_ID=operations-manager
# Temporary backward compatibility: maps only to Owner/Admin; remove after migration.
CSCSKB_MARKETING_ADMIN_TOKEN=

# OpenRouter — free-only AI model routing. Keep this key server-side; never use NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Campaign copy: multilingual instruction model; fallback is a reasoning/planning model.
CSCSKB_MARKETING_MODEL_COPY=google/gemma-4-26b-a4b-it:free
CSCSKB_MARKETING_MODEL_FALLBACK=nvidia/nemotron-3-ultra:free
# Reserved model assignments for future agent capabilities (not yet wired to separate routes).
CSCSKB_MARKETING_MODEL_REASONING=nvidia/nemotron-3-ultra:free
CSCSKB_MARKETING_MODEL_CODE=recursive/flint-v1.0:free
